@page
@model LogoutCompleteModel
@{
    ViewData["Title"] = "Logging out";
    this.Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <title>@ViewData["Title"] - BCKFreight</title>
    <link rel="stylesheet" href="~/css/adminlte.css" asp-append-version="true">
    <style>
        body {
            margin: 0;
            padding: 0;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            background: linear-gradient(135deg, grey, white);
            font-family: 'Source Sans Pro', sans-serif;
        }
        .modern-spinner {
            width: 42px;
            height: 42px;
            border-radius: 50%;
            border: 3px solid rgba(0, 0, 0, 0.14);
            border-top-color: #6b7280;
            animation: spin 0.9s linear infinite;
        }
        @@keyframes spin {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }
    </style>
</head>
<body>
    <div class="modern-spinner" aria-hidden="true"></div>

    <script src="~/plugins/jquery/jquery.js"></script>
    <script src="~/js/jwt-manager.js"></script>
    
    <script>
        (function() {
            let tokenCleared = false;
            
            if (window.jwtManager) {
                try {
                    window.jwtManager.clearToken();
                    console.log('✓ JWT token cleared successfully');
                    tokenCleared = true;
                } catch (error) {
                    console.error('✗ Error clearing JWT token:', error);
                }
            } else {
                console.warn('⚠ JWT Manager not available');
            }
            
            try {
                sessionStorage.clear();
                console.log('✓ Session storage cleared');
            } catch (error) {
                console.error('✗ Error clearing session storage:', error);
            }
            
            if (tokenCleared) {
                const verifyToken = window.jwtManager.getToken();
                if (verifyToken) {
                    console.error('✗ Token still exists after clearing!');
                } else {
                    console.log('✓ Token verified as cleared');
                }
            }
            
            window.location.href = '/Identity/Account/Login';
        })();
    </script>
</body>
</html>
